<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Example Unattend.xml for Complete OOBE Bypass
  
  This file skips most Windows Out-of-Box Experience screens.
  
  Usage:
  1. For USB installation: Copy to USB root and rename to "autounattend.xml"
  2. For WIM injection: Place in C:\Mount\Windows\Panther\unattend.xml
  3. For automated deployment: Include in deployment solution
  
  Sections Skipped:
  - EULA acceptance
  - OEM registration
  - Online account creation
  - Wireless network setup
  - Privacy settings (set to basic)
  - Machine and user OOBE
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend">
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <ProtectYourPC>3</ProtectYourPC>
        <SkipUserOOBE>true</SkipUserOOBE>
        <SkipMachineOOBE>true</SkipMachineOOBE>
      </OOBE>
    </component>
  </settings>
</unattend>
